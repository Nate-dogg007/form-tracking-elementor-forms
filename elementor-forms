<script>
/*
  ░▒▓█ Elementor Pro Forms → Google Ads Enhanced Conversions █▓▒░
  Author:  Nathan O'Connor
  Version: 1.1

  ─────────────────────────────────────────────────────────────
  HOW TO INSTALL

    ONE GTM Custom HTML tag. Paste this whole file in, set the three
    constants in CONFIG below — DEFAULT_COUNTRY, CONSENT_MODE and
    ASSUME_DEFAULT_COUNTRY — trigger it on All Pages, save.

    CONSENT_MODE decides whether anything is collected at all when the page
    emits no consent signal. ASSUME_DEFAULT_COUNTRY is the one most sites
    need and nobody expects: Google throws an address away unless it has
    first name, last name, postcode AND country, and almost no lead form
    asks for country. Leave it false and most forms send no address.

  HOW IT CAPTURES

    Elementor posts the form over AJAX and, on success, fires the jQuery
    event `submit_success` on the form — then resets the form. So by the
    time anything downstream reacts, the values are on their way out.

    This reads the fields at SUBMIT, while they are still there, starts
    hashing them immediately, and commits on `submit_success` once the
    submission is known to have succeeded. Nothing is pushed for a
    submission that fails validation.

    Hashing at submit rather than at success is deliberate. SHA-256 via
    SubtleCrypto is asynchronous, and Elementor's "Redirect" action
    navigates away inside the same success handler. Starting the hash a
    network round-trip earlier means the push at success is almost always
    synchronous, which is the difference between a conversion landing and
    a conversion being lost to the unload.

  MATCHING

    Elementor field IDs are typed in by whoever built the form, so
    `form_fields[email]` means only that someone typed "email" into the
    Advanced tab. The field wrapper carries `elementor-field-type-email`
    and `elementor-field-type-tel`, which come from the field's actual
    type and cannot be edited to say something else. That is the primary
    signal; the field ID is the fallback, and the `autocomplete`
    attribute is the fallback to that.

    This ordering is not theoretical. Real Elementor markup exists in
    which a field labelled and placeholdered "Phone" is named
    `form_fields[email]` while the real email field is
    `form_fields[field_29e0ac1]`. Matching on the ID first would hash a
    phone number into sha256_email_address and match nothing, forever,
    with no error anywhere.

    The label is the last tier and it is not optional. Elementor
    generates `field_0275ba1` for every field nobody renames, and nobody
    renames them, so on a real form the ID is silent and the label is the
    only human-meaningful thing left.

  WHAT IS VERIFIED AND WHAT IS NOT

    Verified against a live Elementor Pro 3.5.2 install: the rendered
    field markup, and the event contract read out of that install's own
    `form.<hash>.bundle.min.js` —

      e.success ? ( t.trigger("submit_success", e.data),
                    t.trigger("form_destruct", e.data),
                    t.trigger("reset"), ... )

    where `t` is the form. So submit_success is a jQuery event on the
    form, and the reset that empties the fields is two statements later
    in the same synchronous run. `form_destruct` is what performs the
    redirect. That is the whole reason the hashing starts at submit: by
    the time success fires there is no room left to await anything.

    NOT verified: a real submission. Reading a client's form is free;
    submitting it creates a real enquiry, so no payload has been captured
    end to end. Run the diagnostic in the README on a real submission
    before treating this as proven.
*/

(function () {
  'use strict';

  /* ══ CONFIG ══════════════════════════════════════════════════════════ */

  // ISO 3166-1 alpha-2 for your primary audience. Used to turn national
  // phone formats (07700 900123) into E.164 (+447700900123). Get this wrong
  // and every hashed phone silently fails to match.
  var DEFAULT_COUNTRY = 'GB';

  // Google will not use an address unless it has first name, last name,
  // postcode AND country. Most lead forms collect the first three and never
  // ask for country. Turn this on to fill country from DEFAULT_COUNTRY when
  // it is the only field missing.
  var ASSUME_DEFAULT_COUNTRY = false;

  // Does this site have a consent management platform?
  //
  //   'cmp'  — yes. An ad_user_data signal is required. No signal means the
  //            CMP is not wired to Consent Mode v2, so nothing is collected.
  //   'none' — no. Nothing on the page gates collection and you have a
  //            lawful basis, so collect when no signal is present.
  //
  // A signal always wins where there is one: 'none' still honours a denial
  // if a CMP turns up and says no. This has to be declared because it
  // cannot be worked out — "no CMP here" and "a CMP that never emits
  // Consent Mode" are the same absence of a signal.
  var CONSENT_MODE = 'cmp';

  // The dataLayer event name. Deliberately NOT `form_submit`: GA4's
  // enhanced measurement collects an automatic event by that exact name.
  var EVENT_NAME = 'elementor_form_submit';

  // Elementor form IDs to ignore entirely. These are the widget IDs from
  // the hidden `form_id` input — seven-ish hex characters, as strings:
  // ['bc7d48e', '7ce0758'].
  var SKIP_FORM_IDS = [];

  // How long to give GTM to fire its tags before giving up on the
  // callback. Only relevant when the form redirects on success.
  var MAX_DELAY_MS = 1200;

  // Log to console. Leave false in production.
  var DEBUG = false;

  /* ════════════════════════════════════════════════════════════════════ */

  var DIAL_CODES = {
    GB: '44',  US: '1',   CA: '1',   IE: '353', AU: '61',  NZ: '64',
    ZA: '27',  IN: '91',  DE: '49',  FR: '33',  ES: '34',  IT: '39',
    NL: '31',  BE: '32',  LU: '352', CH: '41',  AT: '43',  PT: '351',
    SE: '46',  NO: '47',  DK: '45',  FI: '358', IS: '354', PL: '48',
    CZ: '420', SK: '421', HU: '36',  RO: '40',  BG: '359', GR: '30',
    HR: '385', SI: '386', EE: '372', LV: '371', LT: '370', CY: '357',
    MT: '356', JP: '81',  CN: '86',  HK: '852', SG: '65',  MY: '60',
    TH: '66',  PH: '63',  ID: '62',  KR: '82',  AE: '971', SA: '966',
    IL: '972', TR: '90',  BR: '55',  MX: '52',  AR: '54',  CL: '56',
    CO: '57',  NG: '234', KE: '254', EG: '20'
  };

  // Country dropdowns usually hold names, not codes. Google wants alpha-2.
  // Extend this if your audience sits outside the list.
  var COUNTRY_ALIASES = {
    'united kingdom': 'GB', 'great britain': 'GB', 'uk': 'GB',
    'england': 'GB', 'scotland': 'GB', 'wales': 'GB',
    'northern ireland': 'GB',
    'united states': 'US', 'united states of america': 'US',
    'usa': 'US', 'america': 'US',
    'ireland': 'IE', 'republic of ireland': 'IE',
    'australia': 'AU', 'new zealand': 'NZ', 'canada': 'CA',
    'south africa': 'ZA', 'germany': 'DE', 'france': 'FR',
    'spain': 'ES', 'italy': 'IT', 'netherlands': 'NL',
    'belgium': 'BE', 'portugal': 'PT', 'poland': 'PL',
    'sweden': 'SE', 'norway': 'NO', 'denmark': 'DK',
    'finland': 'FI', 'switzerland': 'CH', 'austria': 'AT',
    'india': 'IN', 'japan': 'JP', 'china': 'CN',
    'singapore': 'SG', 'united arab emirates': 'AE', 'uae': 'AE',
    'brazil': 'BR', 'mexico': 'MX'
  };

  // Allowlist. A field is collected only if its normalised name matches
  // one of these exactly (after prefix stripping), or it carries an
  // explicit data-upd attribute. Nothing else leaves the page.
  var SYNONYMS = {
    email: [
      'email', 'emailaddress', 'email_address', 'e_mail', 'mail'
    ],
    phone_number: [
      'phone', 'phonenumber', 'phone_number', 'phone_no', 'tel',
      'telephone', 'telephone_number', 'mobile', 'mobile_number',
      'mobile_phone', 'cell', 'cellphone', 'cell_phone',
      'mobilephone', 'homephone', 'workphone'      // HubSpot property names
    ],
    first_name: [
      'first_name', 'firstname', 'fname', 'first', 'given_name',
      'givenname', 'forename'
    ],
    last_name: [
      'last_name', 'lastname', 'lname', 'last', 'surname',
      'family_name', 'familyname'
    ],
    street: [
      'street', 'street_address', 'streetaddress', 'address',
      'address_1', 'address1', 'address_line_1', 'addressline1',
      'addr', 'addr1'
    ],
    postal_code: [
      'postcode', 'post_code', 'postalcode', 'postal_code',
      'zip', 'zipcode', 'zip_code'
    ],
    country: [
      'country', 'country_code', 'countrycode'
    ]
  };

  // A single field holding a whole name. Split into first + last.
  // Elementor's own starter form ships exactly this, as form_fields[name].
  var FULL_NAME = ['name', 'full_name', 'fullname', 'complete_name'];

  /*
    Accepted only through an explicit data-upd attribute, never matched by
    field name. city and region reach Google unhashed, and no name-based
    heuristic can separate "Hampshire" from "cancer" — a shape check that
    rejects a long sentence still lets "HIV positive" through, and a field
    called `state` is not always a US state. Google needs these only
    alongside a full address, which already requires first name, last
    name, postcode and country, so the match-rate cost is close to nil.
  */
  var EXPLICIT_ONLY = ['city', 'region'];

  /*
    Never matched, however they normalise. Several WordPress form plugins
    ship a `form_name` field carrying the form's own title, which would
    otherwise be split and hashed as the visitor's name — worse than
    over-collecting, because it poisons the match data with something that
    is not a person. A username is not a full name either.
  */
  var NEVER_MATCH = [
    'form_name', 'field_name', 'user_name', 'username',
    'form_id', 'field_id', 'form_title'
  ];

  // Stripped from the front of a field name before matching, so
  // `your-email` and `billing_email` both resolve to `email`.
  var PREFIXES = [
    'your', 'user', 'contact', 'billing', 'shipping', 'delivery',
    'customer', 'client', 'primary', 'main', 'input', 'field',
    'form', 'entry', 'the', 'address', 'fields'
  ];

  // Countries where the national trunk zero is part of the E.164 number
  // rather than something to strip. Italian landlines keep it: 06 1234 5678
  // is +39 06 1234 5678, not +39 612345678. Check your market before
  // trusting this list; it is short because most countries drop the zero.
  var KEEP_TRUNK_ZERO = ['IT'];

  var HASHED_KEYS = ['email', 'phone_number', 'first_name', 'last_name', 'street'];
  var PLAIN_KEYS  = ['city', 'region', 'postal_code', 'country'];

  // city and region are passed through unhashed, so they are the one route
  // by which free text could reach the dataLayer. A field named `state` is
  // not always a US state ("please state your requirements"), so validate
  // shape rather than trusting the field name.
  var MAX_PLAIN_LENGTH = 60;

  function log() {
    if (!DEBUG || !window.console) return;
    try { console.log.apply(console, ['[form-tracking]'].concat([].slice.call(arguments))); } catch (e) {}
  }

  /* ── Install guard ───────────────────────────────────────────────────
     A tag that fires twice must not double-count.                      */

  var STATE = window.__elFormTracking;
  if (!STATE || typeof STATE !== 'object') {
    STATE = window.__elFormTracking = { installed: false };
  }
  if (STATE.installed) {
    log('already installed, skipping');
    return;
  }
  STATE.installed = true;

  var CAN_HASH = !!(window.crypto && window.crypto.subtle);
  if (!CAN_HASH) log('SubtleCrypto unavailable (needs HTTPS) — user data disabled');

  /* ── Runtime consent ────────────────────────────────────────────────
     GTM checks consent once, when it decides whether to run this tag.
     That is not enough on its own. The listener installed here lives for
     the whole page, so a visitor who withdraws consent mid-session would
     otherwise keep having their data read, hashed and disclosed into a
     global array that every other tag on the page can read. So consent is
     re-checked on every submission, not just at install.

     Read from the dataLayer rather than google_tag_data.ics, which is
     internal and undocumented. Consent Mode writes every default and
     update call into the dataLayer, so the last one to mention
     ad_user_data is the current state. Override with
     window.formTrackingConsentFn if your CMP does something unusual.    */

  /*
    Known CMPs, by the cheapest reliable fingerprint each one leaves on the
    page. This list exists for exactly one purpose: to contradict
    CONSENT_MODE = 'none'. It never decides whether to collect.

    That distinction is the whole point. A fingerprint list is always
    incomplete — a custom banner or a CMP added next year will not be on it
    — which makes it unfit to grant or deny anything. It is perfectly fit
    to catch someone declaring 'none' on a site that visibly has a banner,
    because a hit is conclusive even though a miss is not.
  */
  var CMP_SIGNATURES = [
    ['CookieYes', function () {
      return !!window.getCkyConsent ||
             !!document.querySelector('script[src*="cookieyes"]');
    }],
    ['OneTrust', function () {
      return !!window.OneTrust || !!window.Optanon;
    }],
    ['Cookiebot', function () {
      return !!window.Cookiebot || !!document.getElementById('Cookiebot');
    }],
    ['HubSpot', function () {
      return !!document.querySelector(
        'script[src*="hs-banner.com"], script[id^="cookieBanner-"]');
    }],
    ['Complianz', function () {
      return !!window.cmplz_get_cookie ||
             !!document.querySelector('script[src*="complianz"]');
    }],
    ['Termly', function () {
      return !!document.querySelector('script[src*="termly"]');
    }],
    ['Iubenda', function () {
      return !!window._iub;
    }],
    ['Usercentrics', function () {
      return !!window.UC_UI || !!window.usercentrics;
    }],
    ['Osano', function () {
      return !!window.Osano;
    }],
    ['IAB TCF', function () {
      return typeof window.__tcfapi === 'function';
    }]
  ];

  function detectCmp() {
    for (var i = 0; i < CMP_SIGNATURES.length; i++) {
      try {
        if (CMP_SIGNATURES[i][1]()) return CMP_SIGNATURES[i][0];
      } catch (err) {
        // A CMP that throws when probed is not worth failing a submission
        // over. Treat it as absent and keep checking the rest.
      }
    }
    return null;
  }

  var warnedNoConsentSignal = false;
  var warnedCmpContradiction = false;
  var warnedBadConsentMode = false;
  var warnedRegionUnresolved = false;

  /*
    Anything that is not exactly 'none' falls through to the fail-closed
    branch, which is the safe direction but a baffling one to debug: someone
    who typed 'None' gets told to set CONSENT_MODE = "none", which is what
    they believe they did. Say so plainly instead.
  */
  function consentModeIsNone() {
    if (CONSENT_MODE === 'none') return true;
    if (CONSENT_MODE !== 'cmp') {
      warnedBadConsentMode = warnOnce(warnedBadConsentMode,
        'CONSENT_MODE is ' + JSON.stringify(CONSENT_MODE) + ', which is neither ' +
        '"cmp" nor "none". Treating it as "cmp", so no user data will be ' +
        'collected without a consent signal. Check for a typo or stray whitespace.');
    }
    return false;
  }

  // Deliberately not behind DEBUG. Silence in either of these cases looks
  // identical to "enhanced conversions is working", which is the failure
  // this whole script exists to stop.
  function warnOnce(already, message) {
    if (already || !window.console || !console.warn) return true;
    try { console.warn('[form-tracking] ' + message); } catch (err) {}
    return true;
  }

  /*
    Reads the current consent position without judging it: 'granted',
    'denied', or 'no_signal' when nothing readable said either way.

    Every unreadable outcome — a malformed shape, a dataLayer that has been
    reset, a region-scoped entry we cannot place — reports 'no_signal'
    rather than guessing. What that means is CONSENT_MODE's decision, made
    in consentDecision() below, and it is the only place the two are
    allowed to be conflated.
  */
  function consentState() {
    if (typeof window.formTrackingConsentFn === 'function') {
      try {
        // Strict equality on purpose: the natural way to write a CMP
        // adapter returns undefined on its deny branch. Note that defining
        // the function is itself a declaration, so there is no 'no_signal'
        // outcome on this path — an adapter that cannot tell should throw.
        return window.formTrackingConsentFn() === true ? 'granted' : 'denied';
      } catch (err) {
        log('consent function threw, treating as denied', err);
        return 'denied';
      }
    }

    var dl = window.dataLayer;
    var state = null;
    var sawUpdate = false;
    var sawRegionScoped = false;

    if (dl && typeof dl.length === 'number') {
      for (var i = 0; i < dl.length; i++) {
        var entry = dl[i];
        if (!entry || entry[0] !== 'consent') continue;
        var command = entry[1];
        if (command !== 'default' && command !== 'update') continue;
        var settings = entry[2];
        if (!settings || typeof settings !== 'object') continue;
        // Checked before the region test, so a region-scoped entry about
        // some other consent type does not make this one unresolvable.
        if (typeof settings.ad_user_data !== 'string') continue;
        /*
          Region scoping is a feature of the `default` command only —
          Google documents it as "specify a region (according to ISO
          3166-2) in your gtag consent default command", and the gtag
          reference does not list region among the consent parameters at
          all. So a region key on an `update` is not a scoping
          instruction, and treating it as one threw away the visitor's
          own answer: a CMP that builds one settings object and reuses it
          across both commands had its update ignored, and a stale
          earlier denial stood instead.

          Region-scoped defaults are noted, not read — see below.
        */
        // Length-checked, not just truthy: some CMPs emit `region: []`
        // rather than omitting the key, and an empty array is truthy in
        // JavaScript — which turned a perfectly readable global default
        // into region_unresolved and collected nothing.
        if (command === 'default' && settings.region && settings.region.length) {
          sawRegionScoped = true;
          continue;
        }
        /*
          Once the visitor has answered, a later `default` is ignored.

          This is our choice, not a documented Consent Mode guarantee —
          Google's docs are silent on the interaction, and a stray
          `default` re-firing after a CMP's `update` is a known way to
          reset consent state in a real container. We privilege the
          answer because the alternative lets a leftover hardcoded
          default overrule what the visitor actually clicked.

          The residual risk runs one way: update-granted followed by
          default-denied keeps us collecting while Google's own state may
          have reverted. A stray default is a container bug either way,
          and this is the direction that respects the click.
        */
        if (command === 'default' && sawUpdate) continue;
        state = settings.ad_user_data === 'granted';
        if (command === 'update') sawUpdate = true;
      }
    }

    /*
      A visitor who answers the banner gets an update pushed globally, not
      per region, so their own choice resolves the question no matter what
      the regional defaults said. Take it and stop.
    */
    if (sawUpdate) return state ? 'granted' : 'denied';

    /*
      No update, and at least one region-scoped default mentioned
      ad_user_data. This is unresolvable, and it took a live leak to see it.

      The standard Consent Mode v2 configuration is a restrictive default
      for a list of regions plus a permissive global fallback for everyone
      else. Which of those applies depends on where the visitor is, and this
      code runs in a browser that is not told. The previous version skipped
      region-scoped entries as "probably somewhere else" and read the
      fallback instead — so a visitor inside a denied region who never
      touched the banner had their hashed email pushed to the dataLayer,
      reported as a clean success.

      Guessing has no safe direction here: read the fallback and you
      over-collect, ignore it and you under-collect. So report neither.
      CONSENT_MODE decides what silence means, as it does everywhere else,
      and window.formTrackingConsentFn is the way out for a site that really
      does use regional defaults — its CMP knows the region and we do not.
    */
    if (sawRegionScoped) return 'region_unresolved';

    if (state === null) return 'no_signal';
    return state ? 'granted' : 'denied';
  }

  /*
    Turns that reading into a decision, given what the site declared.

      granted   -> collect, whatever CONSENT_MODE says
      denied    -> do not, whatever CONSENT_MODE says
      no_signal -> CONSENT_MODE decides

    A present signal winning in both directions is what makes 'none' safe
    to set on a site that later acquires a CMP: the declaration only ever
    governs the silence.

    Returns { collect, status, cmp }. `cmp` is set only where there was no
    signal to read, and it rides on the payload so the state is visible in
    GTM rather than only in a console nobody has open. A named CMP next to
    a missing signal is the difference between "something is wrong" and
    "go and wire this specific thing up".
  */
  function consentDecision() {
    var state = consentState();

    if (state === 'granted') return { collect: true,  status: 'collected',      cmp: null };
    if (state === 'denied')  return { collect: false, status: 'consent_denied', cmp: null };

    // No readable signal. Whichever way CONSENT_MODE resolves that, whether
    // a CMP is sitting on the page is the fact that tells you what to fix,
    // so look either way — it just means different things in each.
    var cmp = detectCmp();

    if (consentModeIsNone()) {
      // Region-scoped consent entries are themselves proof that something is
      // managing consent here, whether or not it left a fingerprint we know.
      var evidence = cmp ||
        (state === 'region_unresolved' ? 'region-scoped Consent Mode entries are' : null);
      if (evidence) {
        warnedCmpContradiction = warnOnce(warnedCmpContradiction,
          'CONSENT_MODE is "none" but ' + evidence + ' on this page. User data ' +
          'is being collected without checking it. Either wire consent up to ' +
          'Consent Mode v2, point window.formTrackingConsentFn at it, or set ' +
          'CONSENT_MODE = "cmp".');
      }
      return { collect: true, status: 'collected_undeclared', cmp: cmp };
    }

    if (state === 'region_unresolved') {
      warnedRegionUnresolved = warnOnce(warnedRegionUnresolved,
        'consent here is configured per region, and a browser is not told ' +
        'which region the visitor is in — so which default applies to them ' +
        'cannot be worked out and no user data was collected. Visitors who ' +
        'answer the banner are unaffected, because their choice is pushed ' +
        'globally. To collect from the rest, point ' +
        'window.formTrackingConsentFn at your CMP\'s own resolved state.');
      return { collect: false, status: 'region_unresolved', cmp: cmp };
    }

    warnedNoConsentSignal = warnOnce(warnedNoConsentSignal, cmp
      ? cmp + ' is on this page but is not emitting an ad_user_data signal, ' +
        'so user-provided data was not collected. Wire ' + cmp + ' to Consent ' +
        'Mode v2, or point window.formTrackingConsentFn at it.'
      : 'no ad_user_data consent signal found in the dataLayer, so ' +
        'user-provided data was not collected. Configure Consent Mode v2, set ' +
        'window.formTrackingConsentFn, or set CONSENT_MODE = "none" if this ' +
        'site has no CMP and you have another lawful basis.');
    return { collect: false, status: 'no_consent_signal', cmp: cmp };
  }

  /* ── Normalisation ──────────────────────────────────────────────────
     Google's documented rules: trim, lowercase, E.164 phone numbers, and
     strip dots before the domain on gmail.com / googlemail.com.        */

  function normKey(str) {
    return String(str).trim().toLowerCase()
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/_+/g, '_')
      .replace(/^_|_$/g, '');
  }

  function lookup(key) {
    if (FULL_NAME.indexOf(key) !== -1) return 'full_name';
    for (var canonical in SYNONYMS) {
      if (SYNONYMS.hasOwnProperty(canonical) &&
          SYNONYMS[canonical].indexOf(key) !== -1) return canonical;
    }
    return null;
  }

  /*
    Try the allowlist at every prefix-strip level, most specific first.
    Matching only the fully stripped key meant `form_fields[email]`
    stalled on `fields_email` and `address[zip]` never stripped at all, so
    those forms produced nothing. Going level by level also keeps
    `address_1` resolving to street, because it matches before `address`
    is treated as a prefix.
  */
  function matchKey(key) {
    // Checked against the raw key, before any stripping: `form_name`
    // would otherwise strip to `name` and be read as the visitor's.
    if (NEVER_MATCH.indexOf(key) !== -1) return null;
    var parts = key.split('_');
    var guard = 0;
    while (guard <= 4) {
      var candidate = parts.join('_');
      if (!candidate) return null;
      var hit = lookup(candidate);
      if (hit) return hit;
      if (parts.length < 2 || PREFIXES.indexOf(parts[0]) === -1) return null;
      parts.shift();
      guard++;
    }
    return null;
  }

  function normText(v) {
    return String(v).trim().toLowerCase().replace(/\s+/g, ' ');
  }

  function normEmail(v) {
    var s = String(v).trim().toLowerCase().replace(/\s+/g, '');
    var at = s.lastIndexOf('@');
    if (at < 1 || s.indexOf('.', at) === -1 || at === s.length - 1) return '';
    var local = s.slice(0, at);
    var domain = s.slice(at + 1);
    if (domain === 'gmail.com' || domain === 'googlemail.com') {
      // Google's rule for these two domains: drop the plus suffix, then the
      // periods. Jane.Doe+Shopping@googlemail.com -> janedoe@googlemail.com.
      // Skipping the plus step produces a hash Google will never hold, and
      // plus-addressing is common among the people filling in marketing forms.
      local = local.split('+')[0].replace(/\./g, '');
    }
    return local ? local + '@' + domain : '';
  }

  function normPhone(v) {
    var s = String(v).trim();
    // "(0)" is the explicit "drop this when dialling internationally"
    // notation, as in +44 (0)7700 900123.
    s = s.replace(/\(\s*0\s*\)/g, '');
    var international = s.charAt(0) === '+';
    var d = s.replace(/\D/g, '');
    if (!d) return '';

    if (!international) {
      if (d.slice(0, 2) === '00') {
        d = d.slice(2);
      } else {
        var country = String(DEFAULT_COUNTRY).toUpperCase();
        var cc = DIAL_CODES[country];
        if (!cc) return '';                       // unknown country, don't guess
        if (d.charAt(0) === '0' && KEEP_TRUNK_ZERO.indexOf(country) === -1) {
          d = cc + d.replace(/^0+/, '');          // national trunk prefix
        } else if (d.slice(0, cc.length) !== cc) {
          d = cc + d;
        }
      }
    } else if (d.charAt(0) === '0') {
      return '';                                  // +0... is not a country code
    }

    // E.164 is 1–3 digits of country code plus up to 15 total.
    if (d.length < 7 || d.length > 15) return '';
    return '+' + d;
  }

  function normPostal(v) {
    // Collapse internal whitespace rather than stripping it. Google
    // normalises postal codes itself and its own worked example keeps the
    // space (SO99 9XX), so there is nothing to gain from a lossier
    // transform on the one address key UK matching leans on.
    var s = String(v).trim().toLowerCase().replace(/\s+/g, ' ');
    if (!s || s.length > 12 || s.indexOf('@') !== -1) return '';
    return s;
  }

  // For city and region, which are sent unhashed. Reject anything shaped
  // like prose or an identifier rather than a place name.
  function normPlace(v) {
    var s = normText(v);
    if (!s || s.length > MAX_PLAIN_LENGTH) return '';
    if (s.indexOf('@') !== -1) return '';
    if (s.split(' ').length > 4) return '';
    if (/\d{4,}/.test(s)) return '';
    return s;
  }

  function normCountry(v) {
    var s = String(v).trim();
    if (/^[A-Za-z]{2}$/.test(s)) return s.toUpperCase();
    var alias = COUNTRY_ALIASES[normText(s)];
    return alias || '';                           // drop rather than mismatch
  }

  function splitFullName(v) {
    var parts = normText(v).split(' ');
    var clean = [];
    for (var i = 0; i < parts.length; i++) { if (parts[i]) clean.push(parts[i]); }
    if (clean.length < 2) return null;            // one word tells us nothing
    return { first_name: clean[0], last_name: clean[clean.length - 1] };
  }

  function normalise(key, value) {
    switch (key) {
      case 'email':        return normEmail(value);
      case 'phone_number': return normPhone(value);
      case 'postal_code':  return normPostal(value);
      case 'country':      return normCountry(value);
      case 'city':
      case 'region':       return normPlace(value);
      default:             return normText(value);
    }
  }

  /* ── Hashing ────────────────────────────────────────────────────────
     Hex-encoded SHA-256, lowercase, as Google requires.                */

  function sha256Hex(str) {
    if (!str) return Promise.resolve('');
    var data = new TextEncoder().encode(str);
    return window.crypto.subtle.digest('SHA-256', data).then(function (buf) {
      var bytes = new Uint8Array(buf);
      var out = '';
      for (var i = 0; i < bytes.length; i++) {
        out += ('0' + bytes[i].toString(16)).slice(-2);
      }
      return out;
    })['catch'](function (err) {
      log('hash failed', err);
      return '';
    });
  }

  /* ── user_data assembly ─────────────────────────────────────────────
     Google Ads UPD shape. Hashed: email, phone, first/last name, street.
     Plain text: city, region, postal_code, country.                    */

  function buildUserData(raw) {
    var pending = [];
    var hashed = {};

    HASHED_KEYS.forEach(function (key) {
      if (!raw[key]) return;
      pending.push(sha256Hex(raw[key]).then(function (hex) {
        if (hex) hashed[key] = hex;
      }));
    });

    return Promise.all(pending).then(function () {
      var userData = {};
      if (hashed.email)        userData.sha256_email_address = hashed.email;
      if (hashed.phone_number) userData.sha256_phone_number  = hashed.phone_number;

      var address = {};
      if (hashed.first_name) address.sha256_first_name = hashed.first_name;
      if (hashed.last_name)  address.sha256_last_name  = hashed.last_name;
      if (hashed.street)     address.sha256_street     = hashed.street;
      PLAIN_KEYS.forEach(function (key) {
        if (raw[key]) address[key] = raw[key];
      });

      /*
        Country is the field nobody asks for. A UK enquiry form collects a
        name and a postcode and stops, so the set is one value short of
        usable and the value it is short of is the same for every visitor
        the site has.

        Only the country is ever assumed. Guarding this on the rest of the
        set being present would read as extra safety and be dead code — the
        completeness test below already discards an address that is short
        of anything, so stamping a country onto one that is going to be
        dropped changes nothing.
      */
      if (ASSUME_DEFAULT_COUNTRY && !address.country) {
        var assumed = normalise('country', DEFAULT_COUNTRY);
        if (assumed) address.country = assumed;
      }

      /*
        Google's address block is all or nothing: first name, last name,
        postcode and country together, or it discards the whole thing and
        reports "your enhanced conversions addresses are missing required
        fields" in the diagnostics panel.

        So a partial address is not a partial benefit — it is zero benefit
        and a warning. Worse, it is hashed personal data pushed into a
        page-global array for nothing, which is precisely what the rest of
        this file works to avoid. Send the set or send none of it.
      */
      var hasAddress = !!(address.sha256_first_name && address.sha256_last_name &&
                          address.postal_code && address.country);
      if (hasAddress) userData.address = address;
      if (!userData.sha256_email_address && !userData.sha256_phone_number && !hasAddress) {
        log('no matchable identifier, dropping user_data');
        return null;
      }
      return userData;
    });
  }

  /*
    Pushes, and resolves once GTM reports its tags have fired. Every push
    goes through here: a conversion pixel that has not left the browser by
    the time the page unloads is a lost conversion, and that applies just
    as much to the consent-denied event as to the enriched one.

    Elementor's "Redirect" action navigates in the same success handler
    that triggers submit_success, so this is not a theoretical concern
    here the way it is on a form that stays put.
  */
  function pushAndWait(payload) {
    return new Promise(function (resolve) {
      var settled = false;
      var done = function () { if (!settled) { settled = true; resolve(); } };

      window.dataLayer = window.dataLayer || [];
      payload.eventTimeout = MAX_DELAY_MS;
      payload.eventCallback = done;

      setTimeout(done, MAX_DELAY_MS);        // GTM absent or silent
      window.dataLayer.push(payload);
      log('pushed', payload.event, payload);
    });
  }

  /* ── Elementor field mapping ────────────────────────────────────────
     The wrapper type class is the structural signal, because it is
     derived from the field's type and cannot be edited from the form
     builder. The field ID inside form_fields[...] can be, so it comes
     second.                                                           */

  // Decisive when present. Everything else falls through to the field ID.
  var FIELD_TYPE_MAP = {
    email: 'email',
    tel:   'phone_number'
  };

  // Never read, whatever the field is called. `hidden` is on this list
  // because Elementor hidden fields carry gclid, UTMs and page context —
  // machine data, not the visitor's. Attach data-upd to override.
  var SKIP_TYPES = [
    'submit', 'step', 'html', 'hidden', 'password', 'upload',
    'acceptance', 'recaptcha', 'recaptcha_v3', 'honeypot'
  ];

  // Standard autocomplete tokens. The last fallback, for a form whose
  // field IDs are all `field_a1b2c3` but which sets autocomplete properly.
  var AUTOCOMPLETE_MAP = {
    'email': 'email',
    'tel': 'phone_number', 'tel-national': 'phone_number',
    'given-name': 'first_name', 'family-name': 'last_name', 'name': 'full_name',
    'street-address': 'street', 'address-line1': 'street',
    'address-level2': 'city', 'address-level1': 'region',
    'postal-code': 'postal_code', 'country': 'country', 'country-name': 'country'
  };

  function wrapperType(el) {
    var wrap = el.closest ? el.closest('.elementor-field-group') : null;
    if (!wrap || !wrap.className) return '';
    var classes = String(wrap.className).split(/\s+/);
    for (var i = 0; i < classes.length; i++) {
      if (classes[i].indexOf('elementor-field-type-') === 0) {
        return classes[i].slice('elementor-field-type-'.length);
      }
    }
    return '';
  }

  // form_fields[email] -> email. A multi-value field posts as
  // form_fields[interests][], so stop at the first closing bracket.
  function fieldId(name) {
    var m = /^form_fields\[([^\]]+)\]/.exec(String(name || ''));
    return m ? m[1] : '';
  }

  /*
    The last tier, and the one Elementor makes necessary. Elementor
    generates a field ID like `field_0275ba1` for every field nobody
    renames, and nobody renames them — on a real form the ID says nothing
    at all, so without this the street and the postcode are simply lost.

    Matched by the same exact-match discipline as everything else: the
    WHOLE normalised label against the allowlist, never a substring. A
    substring test would read "Email us your question" as an email field,
    and a label is the freest text in the markup.

    city and region stay out of reach here, because they live in
    EXPLICIT_ONLY rather than SYNONYMS and matchKey never consults it. A
    field labelled "City" is still not collected without data-upd. That
    is the point of the split.
  */
  function labelKey(el, form) {
    var texts = [];
    try {
      var id = el.getAttribute && el.getAttribute('id');
      if (id && form && form.querySelectorAll) {
        // Walked rather than selected: an id set by hand can contain
        // characters that need escaping, and CSS.escape is not something
        // to depend on inside a GTM tag.
        var labels = form.querySelectorAll('label[for]');
        for (var i = 0; i < labels.length; i++) {
          if (labels[i].getAttribute('for') === id) {
            texts.push(labels[i].textContent);
            break;
          }
        }
      }
      if (el.getAttribute) {
        texts.push(el.getAttribute('placeholder'));
        texts.push(el.getAttribute('aria-label'));
      }
    } catch (err) { log('could not read a label', err); }

    for (var j = 0; j < texts.length; j++) {
      if (!texts[j]) continue;
      var hit = matchKey(normKey(texts[j]));
      if (hit) return hit;
    }
    return null;
  }

  function canonicalElementorKey(el, form) {
    var explicit = el.getAttribute && el.getAttribute('data-upd');
    if (explicit) {
      var e = normKey(explicit);
      if (e === 'ignore') return null;
      if (e === 'full_name' || FULL_NAME.indexOf(e) !== -1) return 'full_name';
      if (SYNONYMS.hasOwnProperty(e) || EXPLICIT_ONLY.indexOf(e) !== -1) return e;
      log('unknown data-upd value:', explicit);
      return null;
    }

    var type = wrapperType(el);
    if (type && SKIP_TYPES.indexOf(type) !== -1) return null;
    if (FIELD_TYPE_MAP[type]) return FIELD_TYPE_MAP[type];

    // The input's own type, for markup where the wrapper class is absent
    // — a form rendered outside the widget, or a theme that rewrites the
    // field group. Same signal, different place to read it from.
    var inputType = String(el.type || '').toLowerCase();
    if (!type && FIELD_TYPE_MAP[inputType]) return FIELD_TYPE_MAP[inputType];

    var id = fieldId(el.getAttribute && el.getAttribute('name'));
    var hit = id ? matchKey(normKey(id)) : null;
    if (hit) return hit;

    var auto = String(el.getAttribute && el.getAttribute('autocomplete') || '')
      .toLowerCase().split(/\s+/).pop();
    if (AUTOCOMPLETE_MAP.hasOwnProperty(auto)) return AUTOCOMPLETE_MAP[auto];

    return labelKey(el, form);
  }

  function skipField(el) {
    var t = String(el.type || '').toLowerCase();
    if (['INPUT', 'SELECT', 'TEXTAREA'].indexOf(el.tagName) === -1) return true;
    if (el.disabled) return true;
    if (t === 'password' || t === 'submit' || t === 'button' ||
        t === 'reset' || t === 'image' || t === 'file') return true;
    if (t === 'hidden' && !(el.getAttribute && el.getAttribute('data-upd'))) return true;
    if ((t === 'checkbox' || t === 'radio') && !el.checked) return true;
    var ac = String(el.getAttribute && el.getAttribute('autocomplete') || '').toLowerCase();
    if (ac.indexOf('cc-') === 0 || ac === 'new-password' ||
        ac === 'current-password') return true;
    if (el.hasAttribute && el.hasAttribute('data-no-track')) return true;
    return false;
  }

  /*
    On a multi-step form the earlier steps are hidden with a class, not
    removed and not disabled, so every step's fields are still readable
    here at the point the last one is submitted.
  */
  function readElementorFields(form) {
    var els = form.querySelectorAll('input, select, textarea');
    var raw = {};
    var found = false;

    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      if (String(el.type || '').toLowerCase() === 'password') {
        log('password field present, skipping form');
        return null;
      }
      if (skipField(el)) continue;

      var key = canonicalElementorKey(el, form);
      if (!key) continue;

      var value = el.value;
      if (typeof value !== 'string' || !value.trim()) continue;

      if (key === 'full_name') {
        var split = splitFullName(value);
        if (!split) continue;
        if (!raw.first_name) { raw.first_name = split.first_name; found = true; }
        if (!raw.last_name)  { raw.last_name  = split.last_name;  found = true; }
        continue;
      }

      if (raw[key]) continue;
      var norm = normalise(key, value);
      if (!norm) continue;
      raw[key] = norm;
      found = true;
    }

    return found ? raw : null;
  }

  function isElementorForm(form) {
    if (!form || form.tagName !== 'FORM') return false;
    if (form.classList && form.classList.contains('elementor-form')) return true;
    // A theme can drop the class from the form itself; the widget wrapper
    // around it is Elementor's and survives.
    return !!(form.closest && form.closest('.elementor-widget-form'));
  }

  function elementorFormId(form) {
    var hidden = form.querySelector && form.querySelector('input[name="form_id"]');
    if (hidden && hidden.value) return String(hidden.value);
    var widget = form.closest && form.closest('.elementor-widget-form');
    var id = widget && widget.getAttribute && widget.getAttribute('data-id');
    return id ? String(id) : '';
  }

  function formDetails(id, form) {
    var name = '';
    try {
      // getAttribute, not form.name: an input called `name` shadows the
      // property on a form element, and `form_fields[name]` is the field
      // ID Elementor's own starter form ships with.
      if (form && form.getAttribute) {
        name = form.getAttribute('data-form-name') ||
               form.getAttribute('name') ||
               form.getAttribute('aria-label') || '';
      }
    } catch (err) { log('could not read a form name', err); }
    return {
      form_id: String(id || ''),
      form_name: String(name).trim() || ('elementor_form_' + (id || 'unknown'))
    };
  }

  /* ── Capture ────────────────────────────────────────────────────────
     Read and hash at submit, commit at submit_success.                */

  function capture(form) {
    var id = elementorFormId(form);
    if (SKIP_FORM_IDS.indexOf(id) !== -1) {
      form.__eltPending = null;
      return;
    }
    if (form.hasAttribute && form.hasAttribute('data-no-track')) {
      form.__eltPending = null;
      return;
    }

    var pending = {
      details: formDetails(id, form),
      promise: null, userData: null, hashed: false, committed: false,
      status: null, cmp: null
    };

    /*
      The status is decided here, at submit, because that is where consent
      is read and where the fields still exist — but it is reported at
      commit, so it travels on `pending` with everything else.

      Before this existed, five outcomes committed a byte-identical event:
      consent denied, no CMP signal, no matchable field, no SubtleCrypto,
      and hashing failing. A broken install was indistinguishable from a
      working one anywhere downstream.
    */
    // Read before consent is: with no SubtleCrypto nothing can be hashed,
    // so there is no personal data for consent to have an opinion about.
    if (!CAN_HASH) {
      pending.status = 'no_crypto';
    } else {
      // Consent is checked before a single field is read, not after.
      var decision = consentDecision();
      pending.cmp = decision.cmp;

      if (!decision.collect) {
        pending.status = decision.status;
      } else {
        var raw = readElementorFields(form);
        if (!raw) {
          pending.status = 'no_fields';
        } else {
          pending.status = decision.status;
          /*
            buildUserData can throw synchronously as well as reject, and
            `.catch` does not exist until a promise has been returned — so
            a synchronous throw goes straight past it and out of capture().
            On the sibling html-forms plugin that meant no event at all: a
            browser extension replacing crypto.subtle with something whose
            digest() throws made the submission disappear.
          */
          try {
            // Started here, not at success, so the hash is ready before the
            // redirect action has a chance to unload the page.
            pending.promise = buildUserData(raw).then(function (ud) {
              pending.userData = ud;
              if (!ud) pending.status = 'no_fields';
              pending.hashed = true;
              return ud;
            })['catch'](function (err) {
              log('user data failed, falling back to the plain event', err);
              pending.status = 'error';
              pending.hashed = true;
              return null;
            });
          } catch (err) {
            log('user data threw synchronously, falling back to the plain event', err);
            pending.status = 'error';
            pending.promise = null;
          }
        }
      }
    }

    form.__eltPending = pending;
    log('captured form', pending.details.form_id, raw ? '(with user data)' : '(no user data)');
  }

  /*
    A form that was skipped at submit has __eltPending set to null, which
    is not the same as never having been seen — so the two are told apart
    rather than both falling through to a bare push.
  */
  function commit(form) {
    if (!form) return;
    var pending = form.__eltPending;

    if (pending === null) return;                       // deliberately skipped

    if (!pending) {
      // submit_success without a captured submit. The values may still be
      // there — Elementor resets the form after this event, not before —
      // so try, but report the conversion either way.
      var id = elementorFormId(form);
      if (SKIP_FORM_IDS.indexOf(id) !== -1) return;
      log('success with nothing captured for form', id);
      capture(form);
      pending = form.__eltPending;
      if (!pending) return;
    }

    if (pending.committed) return;                      // a second listener
    pending.committed = true;

    /*
      Built when the push happens, not before: the hashing callbacks can
      still move `pending.status` (to no_fields or error), so reading it
      early would report the outcome the submit expected rather than the
      one that occurred.
    */
    /*
      Consent is re-read here, not only at capture. Elementor hashes at
      submit and pushes at submit_success, and a visitor can reject the
      banner in between — which is exactly the window this two-phase shape
      opens. The point of gating the payload is that it reflects the answer
      at the moment of disclosure, and that moment is this one, not the
      submit. A later denial overrides whatever the capture decided.

      The README claimed this happened long before it did. It did not, and
      rewriting the section is what turned the claim up.
    */
    if (pending.userData || pending.promise) {
      var again = consentDecision();
      if (!again.collect) {
        pending.userData = null;
        pending.promise = null;
        pending.status = again.status;
        pending.cmp = again.cmp;
      }
    }

    var send = function (userData) {
      var payload = {
        event: EVENT_NAME,
        form_details: pending.details,
        user_data_status: pending.status
      };
      if (pending.cmp) payload.cmp_detected = pending.cmp;
      if (userData) payload.user_data = userData;
      pushAndWait(payload);
    };

    if (!pending.promise) { send(null); return; }
    if (pending.hashed) { send(pending.userData); return; }
    // The round trip finished faster than SubtleCrypto, which is unusual
    // but not impossible on a cached response.
    pending.promise.then(function (ud) {
      send(ud);
    })['catch'](function () { send(null); });
  }

  /*
    Capture phase, so this runs before Elementor's own submit handler
    calls preventDefault. On a multi-step form the "next" button does not
    submit; if a build ever makes it, the worst case is that pending is
    overwritten with a later read of the same fields.
  */
  document.addEventListener('submit', function (e) {
    try {
      var form = e.target;
      if (!isElementorForm(form)) return;
      capture(form);
    } catch (err) {
      log('submit capture threw', err);
    }
  }, true);

  /*
    submit_success is triggered through jQuery, so it has to be heard
    through jQuery. document.addEventListener('submit_success', ...) is
    the thing people try first and it never fires — a jQuery-triggered
    custom event does not reach native listeners.
  */
  function attachSuccess() {
    if (typeof jQuery === 'undefined') {
      log('jQuery not found — submit_success cannot be observed');
      return;
    }
    jQuery(document).on('submit_success', function (event) {
      try {
        var target = event && event.target;
        var form = (target && target.closest) ? target.closest('form') : null;

        /*
          Gated on the same predicate capture uses, not merely on "is a
          form". An earlier version fell back to accepting any form
          element on the event, which meant an unrelated form on the page
          was reported as an Elementor conversion the moment anything else
          triggered an event by that name.

          Guessing which of the page's forms was submitted would attribute
          the conversion to the wrong one, so a target this cannot resolve
          reports nothing rather than something plausible.
        */
        if (!isElementorForm(form)) {
          log('submit_success with no identifiable Elementor form');
          return;
        }
        commit(form);
      } catch (err) {
        log('success handler threw', err);
      }
    });
  }

  attachSuccess();

  log('installed');
})();
</script>
